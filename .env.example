# HealthBridge environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this example file is safe to commit because it contains placeholders only.
# Never paste real secrets into this file.

# ============================================================================
# REQUIRED
# ============================================================================

# Neon PostgreSQL connection string.
# Neon console -> your project -> Connection Details.
# (NEON_DATABASE_URL is accepted as an alias for the same value.)
# Schemas and tables are created automatically on first connection.
DATABASE_URL=

# Gemini API key - powers ICD-11 disease search, suggestions and diagnosis.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Flask session signing key (logs users in/out, protects session cookies).
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT signing key for the API token endpoints (/auth/token, /bundle/upload).
# Generate independently of SECRET_KEY, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ============================================================================
# OPTIONAL - Google OAuth login (/enhanced/google-login)
# ============================================================================
# Leave empty to keep Google login disabled: the app shows
# "Google login is not configured yet" and username/password login still works.
# Obtain both from: Google Cloud Console -> APIs & Services -> Credentials
# -> Create credentials -> OAuth client ID (Web application).
# Authorised redirect URI must include: http://localhost:8000/enhanced/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# OPTIONAL - NAMASTE terminology API
# ============================================================================
# Leave empty to use the bundled namaste_codes.csv fallback, which works
# without any key. Search results are identical for common queries.
NAMASTE_API_KEY=

# ============================================================================
# OPTIONAL - Gemini model override
# ============================================================================
# Leave empty to use the app's built-in default model and its fallback list.
GEMINI_MODEL=

# ============================================================================
# OPTIONAL - database backend and tuning (defaults are fine)
# ============================================================================

# "postgres" (default) uses DATABASE_URL.
# "sqlite" falls back to the legacy local .db files.
#HB_DB_BACKEND=postgres

# Connection / statement timeouts (milliseconds for timeouts, attempts/delay
# for connection retries).
#HB_DB_CONNECT_TIMEOUT=15
#HB_DB_STATEMENT_TIMEOUT=30000
#HB_DB_CONNECT_ATTEMPTS=3
#HB_DB_CONNECT_RETRY_DELAY=1

# ============================================================================
# OPTIONAL - development only
# ============================================================================
# Set to "development" ONLY on a local machine. It allows the app to start
# without SECRET_KEY by using an insecure development-only fallback key.
# Never set this in production; supply SECRET_KEY instead.
#FLASK_ENV=development
