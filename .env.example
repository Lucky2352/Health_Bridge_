# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# ICD-11 API Credentials (legacy - no longer required)
ICD11_CLIENT_ID=your-client-id-here
ICD11_CLIENT_SECRET=your-client-secret-here

# Google Gemini API Key (for LLM-based ICD-11 lookup)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# NAMASTE API (Optional)
NAMASTE_API_KEY=your-namaste-api-key-here

# Google OAuth2 — get credentials at https://console.cloud.google.com/
# Authorised redirect URI must be: http://localhost:8000/enhanced/google-callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database
DATABASE_URL=sqlite:///enhanced_auth.db

# Server Configuration
HOST=0.0.0.0
PORT=8000