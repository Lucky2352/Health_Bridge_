# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string.
# Get yours from: Neon console -> your project -> Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# "postgres" (default) uses DATABASE_URL. "sqlite" falls back to the legacy
# .db files, which is handy for offline work.
HB_DB_BACKEND=postgres

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# Gemini API key -- powers ICD-11 search on /search-page
# ---------------------------------------------------------------------------
# Without this the search page still returns NAMASTE results, but the ICD-11
# table is empty. Diagnose at any time:  GET /icd11/status
#
# Free key from https://aistudio.google.com/apikey
# Two key formats are in circulation -- "AIza..." and "AQ....". Both are valid.
# A key starting "sk-proj-" is an OpenAI key and Google rejects it with
# API_KEY_INVALID.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite. Override if that id is retired
# for your project; icd11_api.py also falls back automatically.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Optional third-party services. The app runs without any of these.
# ---------------------------------------------------------------------------

# Official NAMASTE API. Unset, search falls back to the bundled namaste_codes.csv.
NAMASTE_API_KEY=

# Google OAuth2 sign-in. Required only for the Google login button; without it
# the page tells you these are missing. Register the redirect URI as
# http://localhost:8000/enhanced/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=